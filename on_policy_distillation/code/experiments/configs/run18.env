# run18: run17 (2B, LoRA r128) sampled at T=1.0 with 8 samples/prompt (32 prompts x 8 = 256)
export STUDENT_MODEL=Qwen/Qwen3.5-2B
export STUDENT_PARAMS_B=2
export EVAL_BASE_MODEL=Qwen/Qwen3.5-2B
export RUN_DIR=/fsx/opd/run18-2b-t1-s8
export STEPS=50
export SAVE_EVERY=25
export LR=2e-5
export INIT_ADAPTER=
export MICRO_BATCH_SIZE=2
export LORA_R=128
export LORA_ALPHA=256          # alpha/r kept at 2, as in run16 (64/32)
export TRAIN_TEMPERATURE=1.0        # exactly on-policy: rollouts come from the policy the loss scores
export SAMPLES_PER_PROMPT=8        # GROUP_SIZE stays 256, so the sampler needs no restart
