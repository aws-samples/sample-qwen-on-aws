# run22: run17's recipe (2B, LoRA r=128, LR 2e-5, 50 steps) on the AWS DLC images:
# vllm:server-cuda (vLLM 0.30.0) for teacher/sampler/eval, pytorch:2.14-cu133 for the trainer.
export RUN_DIR=/fsx/opd/run22-2b-dlc
export EVAL_DIR=/fsx/opd/eval-run22
export STEPS=50
export SAVE_EVERY=25
export EVAL_VOTES=1          # greedy checkpoint sweep, like-for-like with run17
