# run16 -- 2B student with run15's learning rate; needs the sampler re-applied (it serves STUDENT_MODEL)
export STUDENT_MODEL=Qwen/Qwen3.5-2B
export STUDENT_PARAMS_B=2
export EVAL_BASE_MODEL=Qwen/Qwen3.5-2B
export RUN_DIR=/fsx/opd/run16-2b
export STEPS=50
export LR=2e-5
export MICRO_BATCH_SIZE=2      # a 2B at 4 risks OOM on 1024-token rollouts
