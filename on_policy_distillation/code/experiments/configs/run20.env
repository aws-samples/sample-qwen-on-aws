# run20: run17 (2B, LoRA r128, LR 2e-5, 50 steps) with Qwen's native zero-shot \boxed{} prompt
# (TASK=gsm8k_native) instead of the 4-shot "#### N" format. Baseline: /fsx/opd/baseline-gsm8k-native-2b
export TASK=gsm8k_native
export TRAIN_FEWSHOT=0
export EVAL_FEWSHOT=0
export MAX_NEW_TOKENS=1536     # = EVAL_MAX_TOKENS of the native baseline (kept for comparability)
export EVAL_MAX_TOKENS=1536
export MICRO_BATCH_SIZE=1      # 1536-token rollouts: halve the backward chunk (the update is unchanged)
export RUN_DIR=/fsx/opd/run20-2b-native
export EVAL_DIR=/fsx/opd/eval-run20
